@PACKAGE_INIT@
# Refuse unmarked, partial or mixed installations before importing targets.
set(JSDGameEngine_VERSION "@PROJECT_VERSION@")
set(JSDGameEngine_API_VERSION 1)
set(_jsd_receipt "${PACKAGE_PREFIX_DIR}/share/jsd-game-engine/INSTALL.json")
if(NOT EXISTS "${_jsd_receipt}")
 message(FATAL_ERROR "JSD SDK has no installation receipt; rebuild/install the expected engine")
endif()
file(READ "${_jsd_receipt}" _jsd_json)
foreach(_key project_id version api_version)
 string(JSON _jsd_${_key} ERROR_VARIABLE _jsd_error GET "${_jsd_json}" ${_key})
 if(_jsd_error)
  message(FATAL_ERROR "Invalid JSD SDK receipt: ${_jsd_error}")
 endif()
endforeach()
if(NOT _jsd_project_id STREQUAL "jsd.engine" OR NOT _jsd_version STREQUAL JSDGameEngine_VERSION OR NOT _jsd_api_version EQUAL JSDGameEngine_API_VERSION)
 message(FATAL_ERROR "JSD SDK identity/version mismatch")
endif()
string(JSON _jsd_count LENGTH "${_jsd_json}" files)
if(_jsd_count LESS 1)
 message(FATAL_ERROR "JSD SDK receipt has no files")
endif()
math(EXPR _jsd_last "${_jsd_count} - 1")
foreach(_jsd_index RANGE 0 ${_jsd_last})
 string(JSON _jsd_rel MEMBER "${_jsd_json}" files ${_jsd_index})
 if(IS_ABSOLUTE "${_jsd_rel}" OR _jsd_rel MATCHES "(^|/)\\.\\.(/|$)")
  message(FATAL_ERROR "Invalid JSD SDK receipt path")
 endif()
 set(_jsd_file "${PACKAGE_PREFIX_DIR}/${_jsd_rel}")
 if(NOT EXISTS "${_jsd_file}")
  message(FATAL_ERROR "Incomplete JSD SDK: ${_jsd_file}")
 endif()
 string(JSON _jsd_expected GET "${_jsd_json}" files "${_jsd_rel}")
 file(SHA256 "${_jsd_file}" _jsd_actual)
 if(NOT _jsd_actual STREQUAL _jsd_expected)
  message(FATAL_ERROR "Mixed or modified JSD SDK: ${_jsd_file}")
 endif()
endforeach()

string(JSON _jsd_link_count LENGTH "${_jsd_json}" symlinks)
if(_jsd_link_count LESS 2)
 message(FATAL_ERROR "JSD SDK runtime link receipt is incomplete")
endif()
math(EXPR _jsd_link_last "${_jsd_link_count} - 1")
foreach(_jsd_index RANGE 0 ${_jsd_link_last})
 string(JSON _jsd_rel MEMBER "${_jsd_json}" symlinks ${_jsd_index})
 string(JSON _jsd_expected GET "${_jsd_json}" symlinks "${_jsd_rel}")
 set(_jsd_file "${PACKAGE_PREFIX_DIR}/${_jsd_rel}")
 if(NOT IS_SYMLINK "${_jsd_file}")
  message(FATAL_ERROR "Missing JSD SDK runtime link: ${_jsd_file}")
 endif()
 file(READ_SYMLINK "${_jsd_file}" _jsd_actual)
 if(NOT _jsd_actual STREQUAL _jsd_expected)
  message(FATAL_ERROR "Mixed JSD SDK runtime link: ${_jsd_file}")
 endif()
endforeach()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(NOT TARGET SDL2::SDL2)
    find_dependency(SDL2 2.0 CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../SDL2" NO_DEFAULT_PATH)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/JSDTargets.cmake")
if(NOT TARGET Frontier::Engine)
    add_library(Frontier::Engine INTERFACE IMPORTED)
    set_property(TARGET Frontier::Engine PROPERTY INTERFACE_LINK_LIBRARIES JSD::GameEngine)
    add_library(Frontier::EngineStatic INTERFACE IMPORTED)
    set_property(TARGET Frontier::EngineStatic PROPERTY INTERFACE_LINK_LIBRARIES JSD::GameEngineStatic)
endif()
