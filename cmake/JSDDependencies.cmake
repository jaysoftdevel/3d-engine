# All shipped code dependencies are compiled locally. There is no binary SDL lookup.
option(JSD_HEADLESS_ONLY "Allow building without desktop development headers (EGL tests only)" OFF)
set(SDL_SHARED ON CACHE BOOL "Build bundled SDL2 from source" FORCE)
set(SDL_STATIC OFF CACHE BOOL "SDL2 shared runtime is built once for both engine SDK targets" FORCE)
set(SDL_TEST OFF CACHE BOOL "Do not build upstream SDL test library" FORCE)
set(SDL_TESTS OFF CACHE BOOL "Do not build upstream SDL test programs" FORCE)
set(SDL2_DISABLE_SDL2MAIN ON CACHE BOOL "Engine supplies its own main" FORCE)
if(JSD_ENGINE_STANDALONE)
 set(SDL2_DISABLE_INSTALL OFF CACHE BOOL "Install source-built SDL with the SDK" FORCE)
else()
 set(SDL2_DISABLE_INSTALL ON CACHE BOOL "Editor installs runtime libraries only" FORCE)
endif()
set(SDL2_DISABLE_UNINSTALL ON CACHE BOOL "No global uninstall target" FORCE)
# The bundled SDL renderer sources omit Direct3D; the engine uses desktop OpenGL.
if(WIN32)
 set(SDL_RENDER_D3D OFF CACHE BOOL "Use the engine OpenGL renderer" FORCE)
endif()
set(SDL_OFFSCREEN ON CACHE BOOL "Retain SDL offscreen validation backend" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
add_subdirectory(third_party/SDL2 dependencies/sdl2)
if(WIN32)
 target_sources(SDL2 PRIVATE "${CMAKE_CURRENT_LIST_DIR}/SDLWindowsRendererQueries.c")
endif()
if(NOT JSD_HEADLESS_ONLY AND UNIX AND NOT APPLE)
    get_target_property(JSD_SDL_SOURCE_FILES SDL2 SOURCES)
    if(NOT HAVE_OPENGL OR NOT JSD_SDL_SOURCE_FILES MATCHES "/video/(x11|wayland)/")
        message(FATAL_ERROR "Bundled SDL needs OpenGL and X11/Wayland development headers. Run ./install_deps.sh, or set JSD_HEADLESS_ONLY=ON for EGL-only validation.")
    endif()
endif()

foreach(option TARGET_UNIT_TESTS TARGET_HELLO_WORLD TARGET_PERFORMANCE_TEST TARGET_SAMPLES TARGET_VIEWER GENERATE_DEBUG_SYMBOLS OVERRIDE_CXX_FLAGS INTERPROCEDURAL_OPTIMIZATION ENABLE_ALL_WARNINGS ENABLE_INSTALL JPH_USE_DX12 JPH_USE_VK JPH_USE_MTL JPH_USE_CPU_COMPUTE DEBUG_RENDERER_IN_DEBUG_AND_RELEASE PROFILER_IN_DEBUG_AND_RELEASE USE_SSE4_1 USE_SSE4_2 USE_AVX USE_AVX2 USE_AVX512 USE_LZCNT USE_TZCNT USE_F16C USE_FMADD)
    set(${option} OFF CACHE BOOL "JSD portable physics dependency" FORCE)
endforeach()
set(USE_STATIC_MSVC_RUNTIME_LIBRARY OFF CACHE BOOL "Match the engine DLL runtime" FORCE)
set(JPH_BUILD_SHARED_LIBS OFF CACHE BOOL "Static physics linked into engine" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
add_subdirectory(third_party/JoltPhysics/Build dependencies/jolt EXCLUDE_FROM_ALL)
