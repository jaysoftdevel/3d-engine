# Run before project(), compiler probes and bundled dependency configuration.
find_program(JSD_GUARD_PYTHON NAMES python3 REQUIRED)
function(jsd_guard action project_id expected)
  execute_process(COMMAND "${JSD_GUARD_PYTHON}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/project_guard.py"
    "${action}" --root "${CMAKE_CURRENT_SOURCE_DIR}" --project "${project_id}" --expected "${expected}" ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${output}${error}")
  endif()
endfunction()
function(jsd_guard_project project_id expected)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/JSD_PROJECT.json")
  jsd_guard(source "${project_id}" "${expected}")
  if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
    if(NOT DEFINED CMAKE_INSTALL_PREFIX)
      set(CMAKE_INSTALL_PREFIX "${CMAKE_CURRENT_SOURCE_DIR}" CACHE PATH "Project-local installation")
    endif()
    foreach(pair "CMAKE_INSTALL_BINDIR=bin" "CMAKE_INSTALL_LIBDIR=lib" "CMAKE_INSTALL_INCLUDEDIR=include" "CMAKE_INSTALL_DATADIR=share")
      string(REPLACE "=" ";" parts "${pair}")
      list(GET parts 0 key)
      list(GET parts 1 expected_dir)
      if(DEFINED ${key} AND NOT "${${key}}" STREQUAL "" AND NOT "${${key}}" STREQUAL "${expected_dir}")
        message(FATAL_ERROR "Guarded install requires ${key}=${expected_dir}")
      endif()
    endforeach()
    get_cmake_property(guard_variables VARIABLES)
    foreach(key IN LISTS guard_variables)
      if(key MATCHES "^CMAKE_INSTALL_[A-Z]+DIR$" AND NOT key STREQUAL "CMAKE_INSTALL_OLDINCLUDEDIR")
        if(IS_ABSOLUTE "${${key}}" OR "${${key}}" MATCHES "(^|/)\\.\\.(/|$)")
          message(FATAL_ERROR "Install directory escapes prefix: ${key}=${${key}}")
        endif()
      endif()
    endforeach()
    jsd_guard(cmake "${project_id}" "${expected}" --build "${CMAKE_CURRENT_BINARY_DIR}" --prefix "${CMAKE_INSTALL_PREFIX}")
    set(guard_root "${CMAKE_CURRENT_SOURCE_DIR}")
    set(guard_build "${CMAKE_CURRENT_BINARY_DIR}")
    set(guard_install_code [=[
if(NOT "$ENV{DESTDIR}" STREQUAL "")
 message(FATAL_ERROR "Use an explicit guarded prefix instead of DESTDIR")
endif()
execute_process(COMMAND "@JSD_GUARD_PYTHON@" "@guard_root@/tools/project_guard.py" install
 --root "@guard_root@" --project @project_id@ --expected @expected@
 --build "@guard_build@" --prefix "${CMAKE_INSTALL_PREFIX}" RESULT_VARIABLE guard_status)
if(NOT guard_status EQUAL 0)
 message(FATAL_ERROR "Install blocked by project/version guard")
endif()
]=])
    string(CONFIGURE "${guard_install_code}" guard_install_code @ONLY)
    install(CODE "${guard_install_code}" ALL_COMPONENTS)
  endif()
endfunction()
function(jsd_install_receipt project_id expected)
  set(guard_root "${CMAKE_CURRENT_SOURCE_DIR}")
  set(guard_receipt_code [=[
execute_process(COMMAND "@JSD_GUARD_PYTHON@" "@guard_root@/tools/project_guard.py" receipt
 --root "@guard_root@" --project @project_id@ --expected @expected@
 --prefix "${CMAKE_INSTALL_PREFIX}" RESULT_VARIABLE guard_status)
if(NOT guard_status EQUAL 0)
 message(FATAL_ERROR "Could not record install identity")
endif()
]=])
  string(CONFIGURE "${guard_receipt_code}" guard_receipt_code @ONLY)
  install(CODE "${guard_receipt_code}")
endfunction()
